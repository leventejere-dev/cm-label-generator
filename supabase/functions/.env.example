# ---------------------------------------------------------------------------
# Edge Function secrets — SERVER SIDE ONLY.
# These never reach the browser. Set them with:
#     supabase secrets set --env-file supabase/functions/.env
# or one at a time:
#     supabase secrets set GOOGLE_API_KEY=...
# ---------------------------------------------------------------------------

# Which provider to use: google | anthropic | openai
# Omit to auto-select whichever key is present (Google is checked first).
AI_PROVIDER=google

# --- Google Gemini (default) ------------------------------------------------
# Free tier, no credit card: https://aistudio.google.com/apikey
# GEMINI_API_KEY is accepted as an alias.
GOOGLE_API_KEY=

# --- Anthropic (paid alternative) -------------------------------------------
ANTHROPIC_API_KEY=

# --- OpenAI (paid alternative) ----------------------------------------------
OPENAI_API_KEY=

# Override the provider's default model, e.g. a newer Gemini, Claude or GPT
# release. Leave empty to use the provider's built-in default.
AI_MODEL=

# Abort the provider call after this many milliseconds (default 75000).
AI_TIMEOUT_MS=75000

# Private bucket holding the photographed labels.
SOURCE_IMAGE_BUCKET=label-sources

# --- Abuse protection -------------------------------------------------------
# Sliding window per client IP. Defaults: 40 requests per 300 seconds.
RATE_LIMIT_MAX=40
RATE_LIMIT_WINDOW_SECONDS=300

# Comma-separated list of origins allowed to call the function.
# Leave empty to allow any origin (convenient in development).
ALLOWED_ORIGINS=

# NOTE: SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by
# the Supabase platform. Do not set them by hand and never put them in .env files
# that reach the frontend.
