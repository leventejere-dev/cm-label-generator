# ---------------------------------------------------------------------------
# CM Label Generator — frontend environment
# ---------------------------------------------------------------------------
# Copy this file to `.env` for local development, or set these as build-time
# variables in GitHub Actions (Settings -> Secrets and variables -> Actions -> Variables).
#
# ⚠️  ONLY put public/publishable values here.
#     Vite inlines every VITE_* variable into the JavaScript bundle, so anything
#     in this file is readable by anyone who opens the site.
#     The AI provider API key must NEVER appear here — it lives exclusively in
#     Supabase Edge Function secrets (see README §9).
# ---------------------------------------------------------------------------

# --- Supabase (public values, safe to expose) ------------------------------
# Project URL, e.g. https://abcdefghijklmno.supabase.co
VITE_SUPABASE_URL=
# The "anon" / "publishable" key. Never the service_role key.
VITE_SUPABASE_ANON_KEY=

# --- Application behaviour --------------------------------------------------
# Name of the deployed Edge Function that performs AI extraction.
VITE_EXTRACT_FUNCTION_NAME=extract-label

# Mock mode: "true"  -> never calls Supabase or the AI; uses local fixtures and
#                       localStorage. Lets you demo the whole flow with no keys.
#            "false" -> uses Supabase + the Edge Function.
#            "auto"  -> (default) mock when VITE_SUPABASE_URL is empty, else live.
VITE_MOCK_MODE=auto

# Private Supabase Storage bucket that holds the photographed supplier labels.
VITE_SOURCE_IMAGE_BUCKET=label-sources

# Retain the source photograph in Supabase Storage (MVP: true, so extraction
# quality can be inspected). Set to false to run the pipeline without ever
# persisting the photo.
VITE_RETAIN_SOURCE_IMAGE=true

# --- Image pipeline ---------------------------------------------------------
# Longest edge (px) after client-side downscaling. 2200 keeps 6pt label text
# legible while keeping uploads around 400-900 KB. Do not go below ~1600.
VITE_IMAGE_MAX_EDGE=2200
# Target upload size in bytes; JPEG quality is stepped down until this is met.
VITE_IMAGE_TARGET_BYTES=2200000

# --- Branding ---------------------------------------------------------------
# Optional override for the Color Metal logo shown in the app header and on the
# A4 label. Leave empty to use the bundled asset at public/branding/cm-logo.svg.
VITE_CM_LOGO_URL=

# Free-text company line printed in the A4 label footer.
VITE_CM_COMPANY_LINE=SC COLOR-METAL SRL

# --- Diagnostics ------------------------------------------------------------
# Shown in the footer and stored with each label for troubleshooting.
VITE_APP_VERSION=0.1.0
