{
  "name": "cm-label-generator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Generator Etichete CM — fotografiază eticheta de material a furnizorului, citește-o cu AI multimodal, elimină orice urmă a furnizorului și tipărește o etichetă Color Metal standardizată A5.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --base=/cm-label-generator/",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "verify:flow": "node scripts/verify-flow.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "playwright": "^1.62.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
